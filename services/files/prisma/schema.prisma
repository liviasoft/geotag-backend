// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  id          String    @unique
  name        String    @id @unique
  description String?
  boolean     Boolean?  @default(false)
  number      Int?
  string      String?
  list        Json?
  object      Json?
  objectList  Json[]
  created     DateTime?  @default(now())
  updated     DateTime? @updatedAt

  type DataType
}

enum DataType {
  boolean
  number
  string
  list
  object
  objectList
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  emailVisibility Boolean?  @default(false)
  verified        Boolean?  @default(false) @db.Boolean
  username        String?   @unique
  phone           String?   @unique
  phoneData       Json?
  avatar          String?
  avatarUrl       String?
  created         DateTime?  @default(now())
  updated         DateTime? @updatedAt

  addedLocations Location[]
  addedContacts  Contact[]
  notes          LocationNote[]
}

model UserSetting {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  boolean     Boolean?  @default(false)
  number      Int?
  string      String?
  list        Json?
  object      Json?
  objectList  Json[]
  created     DateTime?  @default(now())
  updated     DateTime? @updatedAt

  type DataType
}

model LocationNote {
  id              String   @id @default(cuid())
  note            String
  isSystemNote    Boolean  @default(false)
  author          String?
  location        String?
  measurementFile String?
  type            String?
  details         Json?
  created         DateTime? @default(now())
  updated         DateTime? @updatedAt

  measurementFileData MeasurementFile? @relation(fields: [measurementFile], references: [id], onDelete: SetNull)
  locationData        Location?        @relation(fields: [location], references: [id], onDelete: Cascade)
  authorData          User?            @relation(fields: [author], references: [id], onDelete: SetNull)
}

model Location {
  id                        String    @id @default(cuid())
  name                      String
  address                   String?
  latitude                  Decimal
  longitude                 Decimal
  description               String?
  locationType              String?
  city                      Json?
  deviceData                Json?
  addedBy                   String?
  image                     String?
  imageUrl                  String?
  connectionStatus          String?
  lastConnectionStatusCheck DateTime?
  created                   DateTime?  @default(now())
  updated                   DateTime?  @updatedAt

  measurementMetadata MeasurementMetadata[]
  measurementFiles    MeasurementFile[]
  notes               LocationNote[]
  contacts            Contact[]
  addedByData         User?                 @relation(fields: [addedBy], references: [id], onDelete: SetNull)
  locationTypeData    LocationType?         @relation(fields: [locationType], references: [id], onDelete: SetNull)
}

model MeasurementFile {
  id            String   @id @default(cuid())
  file          String
  fileUrl       String
  location      String
  fileName      String
  timeStamp     DateTime
  metadataId    String?
  fileDeviceUrl String
  created       DateTime? @default(now())
  updated       DateTime? @updatedAt

  metadata     MeasurementMetadata? @relation(fields: [metadataId], references: [id], onDelete: Cascade)
  notes        LocationNote[]
  traces       Trace[]
  points       Point[]
  locationData Location             @relation(fields: [location], references: [id], onDelete: Cascade)
}

model MeasurementMetadata {
  id                       String    @id @default(cuid())
  Limit                    String?
  latitude                 Decimal?
  longitude                Decimal?
  altitude                 Decimal?
  deviceId                 String?
  timeStart                DateTime?
  gpsTimeStamp             DateTime?
  axisDwellTime            Int?
  frequencyRange           String?
  numberOfSatellites       Int?
  numberOfMeasurements     Int?
  measurementTimeInSeconds Int?
  created                  DateTime?  @default(now())
  updated                  DateTime?  @updatedAt

  device           Location?         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  measurementFiles MeasurementFile[]
  measurements     Measurement[]
  traces           Trace[]
}

model Measurement {
  id                    String   @id @default(cuid())
  avg_DBM_M2            Decimal
  min_DBM_M2            Decimal
  max_DBM_M2            Decimal
  test_status           String
  time_in_seconds       Int
  total_avg_DBM_M2      Decimal
  total_min_DBM_M2      Decimal
  total_max_DBM_M2      Decimal
  total_time_in_seconds Int
  measurementMetadataId String?
  created               DateTime? @default(now())
  updated               DateTime? @updatedAt

  measurementMetadata MeasurementMetadata? @relation(fields: [measurementMetadataId], references: [id])
  traces              Trace[]
}

model Trace {
  id                    String   @id @default(cuid())
  name                  String
  measurementId         String?
  measurementMetadataId String?
  measurementFileId     String?
  created               DateTime? @default(now())
  updated               DateTime? @updatedAt

  measurementMetadata MeasurementMetadata? @relation(fields: [measurementMetadataId], references: [id], onDelete: SetNull)
  measurementFile     MeasurementFile?     @relation(fields: [measurementFileId], references: [id], onDelete: Cascade)
  measurement         Measurement?         @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  points              Point[]
}

model Point {
  pointNum          String
  amplitude_DBMV    Decimal? @db.Decimal(10, 2)
  frequency_MHz     Decimal? @db.Decimal(10, 2)
  amplitude_VM      Decimal?
  referenceEMFLimit Decimal?
  exposureRatio     Decimal?
  traceId           String
  measurementFileId String

  trace           Trace           @relation(fields: [traceId], references: [id], onDelete: Cascade)
  measurementFile MeasurementFile @relation(fields: [measurementFileId], references: [id], onDelete: Cascade)

  @@id([measurementFileId, traceId, pointNum])
}

model LocationType {
  id          String   @id @default(cuid())
  icon        String?
  name        String
  iconUrl     String?
  description String?
  created     DateTime? @default(now())
  updated     DateTime? @updatedAt

  locations Location[]
}

model Contact {
  id      String   @id @default(cuid())
  name    String?
  address String?
  email   String?
  phone   String?
  addedBy String?
  created DateTime? @default(now())
  updated DateTime? @updatedAt

  locations   Location[]
  addedByData User?      @relation(fields: [addedBy], references: [id])
}
